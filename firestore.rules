rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── User progress ────────────────────────────────────────────────────
    // Each user can only read/write their own document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Leaderboard ──────────────────────────────────────────────────────
    // Any authenticated user can read the full leaderboard.
    // Each user can only write (update) their own entry.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.uid == uid
                   && request.resource.data.xp is int
                   && request.resource.data.xp >= 0
                   && request.resource.data.name is string
                   && request.resource.data.name.size() <= 32;
    }

  }
}
